# Sourced by scripts/train.sh — edit and re-run to change training params.

STYLEGAN_REPO="/workspace/stylegan2-ada-pytorch"
DATA_ZIP="/workspace/datasets/wikiart512.zip"
OUTDIR="/workspace/training-runs"

# Number of GPUs on the pod (1 for a single RTX 4090).
GPUS=1

# paper512 matches a 512x512 dataset; use paper256/paper1024 if you changed
# --resolution in download_dataset.py and dataset_tool.py accordingly.
CFG="paper512"

# Named pretrained checkpoint to transfer-learn from. Options shipped by
# NVlabs/stylegan2-ada-pytorch: ffhq256, ffhq512, ffhq1024, celebahq256,
# lsundog256, afhqcat512, afhqdog512, afhqwild512, metfaces1024, cifar10.
# Must match CFG's resolution.
RESUME="ffhq512"

# Horizontal flip augmentation — fine for non-figurative/abstract art.
MIRROR=1

# Adaptive discriminator augmentation, essential for small/medium datasets.
AUG="ada"

# Thousands of images shown to the discriminator. 3000 is a reasonable
# transfer-learning budget; you can kill training early once fakes grids
# look good — full convergence isn't required for this aesthetic.
KIMG=3000

# Save a snapshot every SNAP*4 kimg.
SNAP=4
